pkgname=warmup
pkgver=0.4.0
pkgrel=1
pkgdesc='Prepare Narjo Sing stems ahead of time'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/warmup "$pkgdir/usr/bin/warmup"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/warmup.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/warmup.svg"
  install -Dm644 "$startdir/warmup.desktop" "$pkgdir/usr/share/applications/warmup.desktop"
}
