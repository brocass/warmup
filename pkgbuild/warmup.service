[Unit]
Description=Warmup — prepare Narjo Sing stems in the background
Documentation=https://github.com/brocass/warmup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/warmup --service
# journalctl --user -u warmup.service shows what the service is doing.
Environment=QT_FORCE_STDERR_LOGGING=1
# A crashed run (helper gone, pool unmounted) retries instead of giving up.
Restart=on-failure
RestartSec=30
# Stem probing and scanning are throughput work, not latency work.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
